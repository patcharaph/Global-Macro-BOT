# FRED API (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# Supabase — ใช้ service role key (sb_secret_...) ไม่ใช่ publishable key
# Project Settings → API → Service role key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_secret_your_service_role_key_here

# Gmail (Google Account → Security → 2-Step Verification → App Passwords)
GMAIL_SENDER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_RECIPIENT=your_gmail@gmail.com
