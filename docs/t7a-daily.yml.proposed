name: Daily Data Refresh

on:
  schedule:
    - cron: "0 1 * * *"   # 08:00 Bangkok (UTC+7)
  workflow_dispatch:        # manual trigger

permissions:
  contents: write           # commit public/latest.json

jobs:
  daily:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run daily job
        env:
          FRED_API_KEY:       ${{ secrets.FRED_API_KEY }}
          SUPABASE_URL:       ${{ secrets.SUPABASE_URL }}
          SUPABASE_KEY:       ${{ secrets.SUPABASE_KEY }}
          GMAIL_SENDER:       ${{ secrets.GMAIL_SENDER }}
          GMAIL_APP_PASSWORD: ${{ secrets.GMAIL_APP_PASSWORD }}
          GMAIL_RECIPIENT:    ${{ secrets.GMAIL_RECIPIENT }}
        run: python -m flowmacro.scheduler.daily

      - name: Commit public snapshot
        if: success()
        run: |
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git config user.name "github-actions[bot]"
          git add public/latest.json
          git commit -m "chore: daily snapshot ${{ github.run_id }}" || true
          git push || true
